
body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

.game {
  width: 90%;
  max-width: 420px;
  padding: 30px;
  text-align: center;
  background: white;
  border-radius: 20px;
  box-shadow: 0 10px 30px #00000030;
}

h1 {
  color: #4338ca;
}

.scrambled {
  margin: 25px 0;
  padding: 20px;
  background: #eef2ff;
  border-radius: 12px;
  font-size: 36px;
  font-weight: bold;
  letter-spacing: 8px;
  color: #4338ca;
}

input {
  box-sizing: border-box;
  width: 100%;
  padding: 12px;
  margin-bottom: 12px;
  border: 2px solid #ddd;
  border-radius: 8px;
  font-size: 16px;
}

button {
  padding: 12px 18px;
  margin: 5px;
  border: none;
  border-radius: 8px;
  background: #4f46e5;
  color: white;
  font-size: 15px;
  cursor: pointer;
}

button:hover {
  background: #3730a3;
}

#feedback {
  min-height: 24px;
  font-weight: bold;
}
